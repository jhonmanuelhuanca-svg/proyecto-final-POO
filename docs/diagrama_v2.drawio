l id="c111" value="1..*" style="edgeLabel;html=1;resizable=0;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#d79b00;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c110"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c112" value="1" style="edgeLabel;html=1;resizable=0;align=right;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#d79b00;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c110"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c113" value="" style="endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.5;entryY=1;strokeWidth=2;html=1;rounded=0;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ComboProducto" target="Producto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c114" value="0..*" style="edgeLabel;html=1;resizable=0;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#d79b00;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c113"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c115" value="1" style="edgeLabel;html=1;resizable=0;align=right;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#d79b00;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c113"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c116" value="items" style="endArrow=diamondThin;endFill=0;endSize=16;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=0;entryX=0.1;entryY=1;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Producto" target="Pedido"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c117" value="0..*" style="edgeLabel;html=1;resizable=0;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c116"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c118" value="1" style="edgeLabel;html=1;resizable=0;align=right;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c116"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c119" value="" style="endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.3;entryX=0.5;entryY=0;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pedido" target="Cliente"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c120" value="0..*" style="edgeLabel;html=1;resizable=0;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c119"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c121" value="1" style="edgeLabel;html=1;resizable=0;align=right;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c119"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c122" value="se paga con" style="endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.8;entryX=0;entryY=0.5;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pedido" target="MetodoPago"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c123" value="1" style="edgeLabel;html=1;resizable=0;align=left;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c122"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c124" value="0..1" style="edgeLabel;html=1;resizable=0;align=right;verticalAlign=bottom;fontSize=12;fontStyle=1;fontColor=#000000;labelBackgroundColor=none;" connectable="0" vertex="1" parent="c122"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c125" value="usa" style="endArrow=open;endSize=10;edgeStyle=orthogonalEdgeStyle;dashed=1;html=1;rounded=0;strokeColor=#000000;fontColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Pedido" target="EstadoPedido"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="validacion" value="&lt;b&gt;Validación (Combo)&lt;/b&gt;&lt;br&gt;• De 2 a 4 productos (variante C)&lt;br&gt;• No puede contenerse a sí mismo&lt;br&gt;• Puede contener otros combos" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1452" y="949" width="280" height="90" as="geometry"/></mxCell><mxCell id="valedge" style="endArrow=none;dashed=1;html=1;strokeColor=#d6b656;" edge="1" parent="1" source="validacion" target="Combo"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cambios" value="&lt;b&gt;CAMBIOS RESPECTO AL DIAGRAMA v1 (sellado)&lt;/b&gt;&lt;br&gt;Se mantienen todas las clases, atributos y métodos del diagrama sellado. Cambios:&lt;br&gt;1. Se quitó ItemPedido: Pedido guarda los productos en items (una vez por unidad).&lt;br&gt;2. Producto, Pedido y MetodoPago no son abstractas (autorizado por el docente).&lt;br&gt;3. Pedido: items pasa a protegido (#) para que las subclases lo usen; + cliente&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(relación con Cliente), calcular_cargos(subtotal) y pagar() para guardar el pago.&lt;br&gt;4. Combo: nombre se hereda de Producto (no se repite); + MAX_PRODUCTOS = 4 y&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;esta_disponible() (regla 4: depende de sus productos).&lt;br&gt;5. Bebida: + es_jarra; precio_jarra = 3 × precio_vaso.&lt;br&gt;6. PedidoDelivery: + zonas (junto a tarifas), minutos_retraso (regla 9) y pagar()&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;que valida el pedido mínimo y rechaza tarjeta.&lt;br&gt;7. MetodoPago: + permite_delivery (PagoTarjeta = False).&lt;br&gt;8. Se quitó Restaurante (indicación del docente); el menú es SistemaPedidos (main.py)." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="640" height="300" as="geometry"/></mxCell><mxCell id="leyenda" value="&lt;b&gt;LEYENDA&lt;/b&gt;&lt;br&gt;-  privado &amp;nbsp;&amp;nbsp; #  protegido &amp;nbsp;&amp;nbsp; +  público&lt;br&gt;&lt;u&gt;subrayado&lt;/u&gt; = atributo de clase (constante)&lt;br&gt;★ var. C = valor propio de la Variante C&lt;br&gt;&lt;br&gt;&lt;b&gt;Relaciones&lt;/b&gt;&lt;br&gt;△ triángulo vacío = herencia (hija → padre)&lt;br&gt;◆ rombo lleno = composición&lt;br&gt;◇ rombo vacío = agregación&lt;br&gt;→ flecha simple = asociación&lt;br&gt;- - → punteada = dependencia (usa)" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1430" y="60" width="330" height="250" as="geometry"/></mxCell><mxCell id="variante" value="&lt;b&gt;VARIANTE C&lt;/b&gt;&lt;br&gt;• Descuento del combo: 8 %&lt;br&gt;• Envase para llevar: Bs 1,50 por producto&lt;br&gt;• Envío gratis: desde Bs 200, solo Cercado&lt;br&gt;• Pedido mínimo delivery: Bs 35&lt;br&gt;• Un combo tiene de 2 a 4 productos" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacing=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1790" y="60" width="300" height="140" as="geometry"/></mxCell><mxCell id="titulo" value="Sistema de Pedidos Sabor Valluno – Diagrama de Clases v2 (Variante C)" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="-10" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>